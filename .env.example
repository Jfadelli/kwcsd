# Copy to .env.local (not committed) and fill in, then rebuild.

# reCAPTCHA v3 *site* key (public). Leave empty to run without reCAPTCHA.
# The matching *secret* key goes in api/config.php on the server.
VITE_RECAPTCHA_SITE_KEY=

# Override the form endpoint (normally leave empty: /api/send_email.php on the same domain).
VITE_EMAIL_API=
