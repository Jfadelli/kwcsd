# Only the form endpoint is reachable from the web. config.php, PHPMailer and
# the rate-limit storage folder can't be requested directly.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <Files "send_email.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "send_email.php">
    Allow from all
  </Files>
</IfModule>
