Options -MultiViews
RewriteEngine On

# Let real files and folders (including /api) through untouched.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is a client-side route: serve the React app.
RewriteRule ^ index.html [QSA,L]

# Long-lived caching for fingerprinted build assets.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|jpg|jpeg|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
