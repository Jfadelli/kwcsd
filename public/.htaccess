Options -MultiViews -Indexes
RewriteEngine On

# Send plain-http visitors to https, as v1 did. The live domain (with or
# without www) goes to https://www.kwcsandiego.com; any other host, such as
# staging, keeps its own name.
RewriteCond %{SERVER_PORT} 80
RewriteCond %{HTTP_HOST} ^(www\.)?kwcsandiego\.com$ [NC]
RewriteRule ^(.*)$ https://www.kwcsandiego.com/$1 [R=301,L]
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Let real files and folders (including /api) through untouched.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else is a client-side route: serve the React app.
RewriteRule ^ index.html [QSA,L]

# Long-lived caching for fingerprinted build assets.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|jpg|jpeg|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
